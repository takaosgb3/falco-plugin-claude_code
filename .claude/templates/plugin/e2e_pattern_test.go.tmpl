// --- Pattern JSON Schema Types ---

// PatternFile represents a pattern JSON file with category and patterns.
type PatternFile struct {
	Category string    `json:"category"`
	Patterns []Pattern `json:"patterns"`
}

// Pattern represents a single test pattern entry.
type Pattern struct {
	ID             string `json:"id"`
	Description    string `json:"description"`
	Payload        string `json:"payload"`
	ExpectedRule   string `json:"expected_rule"`
	AttackType     string `json:"attack_type"`
	Severity       string `json:"severity"`
	Encoding       string `json:"encoding"`
	Format         string `json:"format"`
	ExpectedThreat string `json:"expected_threat"`
	Field          string `json:"field"`
	Note           string `json:"note"`
}

// patternsDir returns the path to the patterns directory.
func patternsDir() string {
	return filepath.Join("..", "..", "test", "e2e", "patterns", "categories")
}

// loadPatternFile loads a single pattern JSON file.
func loadPatternFile(t *testing.T, filename string) PatternFile {
	t.Helper()
	path := filepath.Join(patternsDir(), filename)
	data, err := os.ReadFile(path)
	require.NoError(t, err, "Failed to read pattern file: %s", filename)

	var pf PatternFile
	err = json.Unmarshal(data, &pf)
	require.NoError(t, err, "Failed to parse pattern file: %s", filename)
	return pf
}

// loadAllPatterns loads all pattern JSON files from the categories directory.
func loadAllPatterns(t *testing.T) []PatternFile {
	t.Helper()
	dir := patternsDir()
	entries, err := os.ReadDir(dir)
	require.NoError(t, err, "Failed to read patterns directory")

	files := make([]PatternFile, 0, len(entries))
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
			continue
		}
		pf := loadPatternFile(t, entry.Name())
		files = append(files, pf)
	}
	require.NotEmpty(t, files, "No pattern files found")
	return files
}

// --- TC-3-01: All Categories True Positive Test ---

func TestPatternAllCategories(t *testing.T) {
	detector := parser.NewSimpleSecurityDetector(10 * 1024)
	allPatterns := loadAllPatterns(t)

	// 4 threat categories + suspicious_agent
	threatCategories := map[string]bool{
		"sqli":             false,
		"xss":              false,
		"path_traversal":   false,
		"cmd_injection":    false,
		"suspicious_agent": false,
	}

	totalPatterns := 0
	for _, pf := range allPatterns {
		if _, ok := threatCategories[pf.Category]; !ok {
			continue
		}

		t.Run(pf.Category, func(t *testing.T) {
			for _, pattern := range pf.Patterns {
				t.Run(pattern.ID, func(t *testing.T) {
					if pattern.Field == "user_agent" {
						// C-002: suspicious_agent uses separate detection
						detected := detector.DetectSuspiciousAgent(pattern.Payload)
						assert.True(t, detected,
							"Pattern %s: expected suspicious agent detection for payload: %.100s",
							pattern.ID, pattern.Payload)
					} else {
						threatType, detected := detector.DetectSecurityThreat(pattern.Payload)
						assert.True(t, detected,
							"Pattern %s: expected detection for payload: %.100s",
							pattern.ID, pattern.Payload)
						assert.Equal(t, pattern.AttackType, threatType,
							"Pattern %s: expected threat %q, got %q",
							pattern.ID, pattern.AttackType, threatType)
					}
				})
				totalPatterns++
			}
		})
		threatCategories[pf.Category] = true
	}

	// Verify all categories have been tested
	for cat, tested := range threatCategories {
		assert.True(t, tested, "Category %q was not tested - no pattern file found", cat)
	}

	// Verify minimum pattern count (5 categories x 4 patterns = 20)
	assert.GreaterOrEqual(t, totalPatterns, 20,
		"Expected at least 20 True Positive patterns, got %d", totalPatterns)
}

// --- TC-3-02: True Negative Test ---

func TestPatternTrueNegative(t *testing.T) {
	benignPath := filepath.Join(patternsDir(), "benign.json")
	if _, err := os.Stat(benignPath); os.IsNotExist(err) {
		t.Skip("benign.json not yet available")
	}

	detector := parser.NewSimpleSecurityDetector(10 * 1024)
	pf := loadPatternFile(t, "benign.json")

	require.Equal(t, "benign", pf.Category)
	require.GreaterOrEqual(t, len(pf.Patterns), 5, "benign.json must have at least 5 patterns")

	for _, pattern := range pf.Patterns {
		t.Run(pattern.ID, func(t *testing.T) {
			if pattern.Field == "user_agent" {
				detected := detector.DetectSuspiciousAgent(pattern.Payload)
				assert.False(t, detected,
					"Pattern %s: benign user-agent should not be detected as suspicious",
					pattern.ID)
			} else {
				_, detected := detector.DetectSecurityThreat(pattern.Payload)
				assert.False(t, detected,
					"Pattern %s: benign payload should not trigger detection: %.100s",
					pattern.ID, pattern.Payload)
			}
		})
	}
}

// --- TC-3-04: Input Size Boundary Test (NFR-021) ---

func TestPatternInputSizeLimit(t *testing.T) {
	detector := parser.NewSimpleSecurityDetector(10 * 1024)

	tests := []struct {
		name     string
		size     int
		hasThreat bool
	}{
		{"under_10KB", 10239, false},
		{"exact_10KB", 10240, false},
		{"over_10KB_with_threat", 10241, true},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var payload string
			if tt.hasThreat {
				// Put SQLi pattern at start, pad with safe characters
				payload = "' OR '1'='1" + strings.Repeat("A", tt.size-len("' OR '1'='1"))
			} else {
				payload = strings.Repeat("A", tt.size)
			}

			assert.Equal(t, tt.size, len(payload), "Payload size mismatch")

			threatType, detected := detector.DetectSecurityThreat(payload)
			if tt.hasThreat {
				assert.True(t, detected,
					"Threat in first 10KB should be detected even for %d byte input", tt.size)
				assert.Equal(t, "sqli", threatType)
			} else {
				assert.False(t, detected,
					"Safe %d byte input should not trigger detection", tt.size)
			}
		})
	}
}

// --- TC-3-05: Case Insensitive Test ---

func TestPatternCaseInsensitive(t *testing.T) {
	detector := parser.NewSimpleSecurityDetector(10 * 1024)

	tests := []struct {
		name     string
		payload  string
		expected string
	}{
		{
			name:     "uppercase_sqli",
			payload:  "' OR '1'='1",
			expected: "sqli",
		},
		{
			name:     "mixed_case_script",
			payload:  "<ScRiPt>alert(1)</sCrIpT>",
			expected: "xss",
		},
		{
			name:     "uppercase_etc_passwd",
			payload:  "/ETC/PASSWD",
			expected: "path_traversal",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			threatType, detected := detector.DetectSecurityThreat(tt.payload)
			assert.True(t, detected, "Case insensitive test %q failed", tt.name)
			assert.Equal(t, tt.expected, threatType)
		})
	}
}
