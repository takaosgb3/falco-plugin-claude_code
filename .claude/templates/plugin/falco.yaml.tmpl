# Falco configuration for ${PLUGIN_NAME} plugin
# ⚠️ P007: rules_files must use individual file paths (NOT directory paths)
# ⚠️ P008: load_plugins is REQUIRED (without it, the plugin is ignored)
# ⚠️ P009: rate: 0 and max_burst: 0 to prevent alert suppression

plugins:
  - name: ${PLUGIN_NAME}
    library_path: /usr/share/falco/plugins/lib${PLUGIN_NAME}-plugin.so
    init_config: |
      {"log_paths": ["${LOG_PATH_DEFAULT}"]}

# ⚠️ P008: This directive is REQUIRED. Without it, the plugin will not be loaded.
load_plugins: [${PLUGIN_NAME}]

# ⚠️ P007: Use individual file paths, NOT directory paths.
# Directory paths may cause rules to load but NOT register with the rule engine.
rules_files:
  - /etc/falco/rules.d/${PLUGIN_NAME}_rules.yaml

stdout_output:
  enabled: true
  rate: 0        # ⚠️ P009: No rate limiting (default may suppress alerts)
  max_burst: 0   # ⚠️ P009: No burst limiting
