name: E2E Tests

on:
  push:
    branches: [main]
    paths:
      - 'pkg/**'
      - 'cmd/**'
      - 'test/**'
      - 'rules/**'
  pull_request:
    branches: [main]
    paths:
      - 'pkg/**'
      - 'cmd/**'
      - 'test/**'
      - 'rules/**'
  workflow_dispatch:

jobs:
  e2e-tests:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Level 1 - Pattern Coverage Tests
        run: make e2e-pattern

      - name: Level 2 - Pipeline Tests
        run: make e2e-pipeline

      - name: Save Test Output
        if: always()
        run: |
          mkdir -p e2e-results
          go test ./test/e2e/ -v -run TestPattern -count=1 > e2e-results/pattern.log 2>&1 || true
          go test ./cmd/plugin-sdk/ -v -run TestPipeline -count=1 -timeout 120s > e2e-results/pipeline.log 2>&1 || true

      - name: Upload Test Results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-results
          path: e2e-results/
          retention-days: 30
