// TC-6-04: File deleted during monitoring
func TestPipelineFileDeleted(t *testing.T) {
	dir := t.TempDir()
	logPath := filepath.Join(dir, "delete.log")
	_ = os.WriteFile(logPath, []byte(""), 0600)

	p := initPlugin(t, []string{logPath})
	inst := openAndCleanup(t, p)

	// Write a line first to verify it works
	writeToLog(t, logPath, sampleLogLine())
	evt := waitForEvent(t, inst.eventCh, 5*time.Second)
	assert.NotNil(t, evt)

	// Delete the file
	err := os.Remove(logPath)
	require.NoError(t, err)

	// P021: Allow time for fsnotify to detect the deletion
	time.Sleep(500 * time.Millisecond)

	// Plugin should not crash - it should continue running
	assert.NotNil(t, inst.eventCh, "Plugin should not crash when file is deleted")
}

