// TC-2-01: Basic log ingestion (combined format)
func TestPipelineBasicIngestion(t *testing.T) {
	dir := t.TempDir()
	logPath := filepath.Join(dir, "access.log")
	_ = os.WriteFile(logPath, []byte(""), 0600)

	p := initPlugin(t, []string{logPath})
	inst := openAndCleanup(t, p)

	writeToLog(t, logPath, sampleLogLine())

	evt := waitForEvent(t, inst.eventCh, 5*time.Second)
	assert.Equal(t, "192.168.1.100", evt.RemoteAddr)
	assert.Equal(t, "admin", evt.RemoteUser)
	assert.Equal(t, "GET", evt.Method)
	assert.Equal(t, "/api/health", evt.Path)
	assert.Equal(t, "status=ok", evt.QueryString)
	assert.Equal(t, "HTTP/1.1", evt.Protocol)
	assert.Equal(t, uint64(200), evt.Status)
	assert.Equal(t, uint64(1234), evt.BytesSent)
	assert.Equal(t, "https://example.com", evt.Referer)
	assert.Equal(t, "Mozilla/5.0", evt.UserAgent)
	assert.Equal(t, logPath, evt.LogPath)
	assert.NotEmpty(t, evt.Raw)
}

// TC-2-04: Multiple file watch
func TestPipelineMultiFileWatch(t *testing.T) {
	dir := t.TempDir()
	files := []string{
		filepath.Join(dir, "access1.log"),
		filepath.Join(dir, "access2.log"),
		filepath.Join(dir, "access3.log"),
	}
	for _, f := range files {
		_ = os.WriteFile(f, []byte(""), 0600)
	}

	p := initPlugin(t, files)
	inst := openAndCleanup(t, p)

	// Write different log lines to each file
	lines := []string{
		`10.0.0.1 - - [27/Feb/2026:10:00:00 +0000] "GET /path1 HTTP/1.1" 200 100 "-" "Agent1"`,
		`10.0.0.2 - - [27/Feb/2026:10:00:01 +0000] "GET /path2 HTTP/1.1" 200 200 "-" "Agent2"`,
		`10.0.0.3 - - [27/Feb/2026:10:00:02 +0000] "GET /path3 HTTP/1.1" 200 300 "-" "Agent3"`,
	}
	for i, f := range files {
		writeToLog(t, f, lines[i])
	}

	// Collect events from all files (key by LogPath to verify multi-file monitoring)
	events := make(map[string]*PluginEvent)
	timeout := time.After(5 * time.Second)
	for len(events) < 3 {
		select {
		case evt := <-inst.eventCh:
			events[evt.LogPath] = evt
		case <-timeout:
			t.Fatalf("Timeout: got %d of 3 events", len(events))
		}
	}

	assert.Contains(t, events, files[0])
	assert.Contains(t, events, files[1])
	assert.Contains(t, events, files[2])
}

// TC-2-05: GOB round-trip (CRITICAL)
func TestPipelineGOBRoundTrip(t *testing.T) {
	ts := time.Date(2026, 2, 27, 10, 0, 0, 0, time.UTC)
	original := &PluginEvent{
		RemoteAddr:  "192.168.1.100",
		RemoteUser:  "admin",
		TimeLocal:   "27/Feb/2026:10:00:00 +0000",
		Method:      "GET",
		Path:        "/api/health",
		QueryString: "status=ok",
		Protocol:    "HTTP/1.1",
		Status:      200,
		BytesSent:   1234,
		Referer:     "https://example.com",
		UserAgent:   "Mozilla/5.0",
		LogPath:     "/var/log/access.log",
		Raw:         sampleLogLine(),
		Timestamp:   ts,
		Headers:     map[string]string{"x-request-id": "req-123", "x-forwarded-for": "10.0.0.1"},
	}

	// Encode
	data := gobEncode(t, original)
	assert.NotEmpty(t, data)

	// Decode
	decoded := gobDecode(t, data)

	// Verify ALL fields survive round-trip
	assert.Equal(t, original.RemoteAddr, decoded.RemoteAddr)
	assert.Equal(t, original.RemoteUser, decoded.RemoteUser)
	assert.Equal(t, original.TimeLocal, decoded.TimeLocal)
	assert.Equal(t, original.Method, decoded.Method)
	assert.Equal(t, original.Path, decoded.Path)
	assert.Equal(t, original.QueryString, decoded.QueryString)
	assert.Equal(t, original.Protocol, decoded.Protocol)
	assert.Equal(t, original.Status, decoded.Status)
	assert.Equal(t, original.BytesSent, decoded.BytesSent)
	assert.Equal(t, original.Referer, decoded.Referer)
	assert.Equal(t, original.UserAgent, decoded.UserAgent)
	assert.Equal(t, original.LogPath, decoded.LogPath)
	assert.Equal(t, original.Raw, decoded.Raw)
	assert.True(t, original.Timestamp.Equal(decoded.Timestamp),
		"Timestamp: expected %v, got %v", original.Timestamp, decoded.Timestamp)
	assert.Equal(t, original.Headers, decoded.Headers)
}

