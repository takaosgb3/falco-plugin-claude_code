// Fields() definition consistency
func TestPipelineFieldsConsistency(t *testing.T) {
	p := &MyPlugin{}
	_ = p.Init("")

	fields := p.Fields()
	assert.GreaterOrEqual(t, len(fields), 14, "Must have at least 14 fields")

	// Verify all field names are unique and start with "${EVENT_SOURCE}."
