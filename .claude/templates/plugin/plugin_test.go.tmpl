// --- Helper Functions ---

// initPlugin creates and initializes a plugin with custom log paths.
func initPlugin(t *testing.T, logPaths []string) *MyPlugin {
	t.Helper()
	p := &MyPlugin{}
	cfg := PluginConfig{
		LogPaths:        logPaths,
		EventBufferSize: 100,
	}
	cfgJSON, err := json.Marshal(cfg)
	require.NoError(t, err)
	err = p.Init(string(cfgJSON))
	require.NoError(t, err)
	return p
}

// openAndCleanup opens the plugin instance and registers cleanup.
// Note: Open() returns source.Instance (SDK interface). We need type assertion
// to access *MyInstance fields like eventCh.
func openAndCleanup(t *testing.T, p *MyPlugin) *MyInstance {
	t.Helper()
	inst, err := p.Open("")
	require.NoError(t, err)
	mi := inst.(*MyInstance)
	t.Cleanup(func() { mi.Close() })
	return mi
}

// writeToLog writes a line to a log file and waits for fsnotify.
func writeToLog(t *testing.T, path, line string) {
	t.Helper()
	f, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0644)
	require.NoError(t, err)
	defer f.Close()
	_, err = f.WriteString(line + "\n")
	require.NoError(t, err)
}

// waitForEvent waits for an event on the channel with timeout.
func waitForEvent(t *testing.T, ch chan *PluginEvent, timeout time.Duration) *PluginEvent {
	t.Helper()
	select {
	case evt := <-ch:
		return evt
	case <-time.After(timeout):
		t.Fatal("Timed out waiting for event")
		return nil
	}
}

// gobEncode encodes a PluginEvent to bytes.
func gobEncode(t *testing.T, event *PluginEvent) []byte {
	t.Helper()
	var buf bytes.Buffer
	err := gob.NewEncoder(&buf).Encode(event)
	require.NoError(t, err)
	return buf.Bytes()
}

// gobDecode decodes bytes into a PluginEvent.
func gobDecode(t *testing.T, data []byte) PluginEvent {
	t.Helper()
	var event PluginEvent
	err := gob.NewDecoder(bytes.NewReader(data)).Decode(&event)
	require.NoError(t, err)
	return event
}

// sampleLogLine returns a sample combined log format line for testing.
func sampleLogLine() string {
	return `192.168.1.100 - admin [27/Feb/2026:10:00:00 +0000] "GET /api/health?status=ok HTTP/1.1" 200 1234 "https://example.com" "Mozilla/5.0"`
}

